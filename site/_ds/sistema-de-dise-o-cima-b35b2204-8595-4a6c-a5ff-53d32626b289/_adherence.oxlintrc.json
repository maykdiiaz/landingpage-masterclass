      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: type, size, tone, style."
