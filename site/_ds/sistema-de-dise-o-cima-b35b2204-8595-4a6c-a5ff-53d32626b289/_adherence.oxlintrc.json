        "message": "<Mark> type must be one of 'key' | 'process' | 'decision' | 'direction' | 'note'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|muted|primary)$/]",
